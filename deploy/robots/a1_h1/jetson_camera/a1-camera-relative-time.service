[Unit]
Description=A1 project-scoped relative camera time relay
After=pingpong-detect.service
Requires=pingpong-detect.service
PartOf=pingpong-detect.service

[Service]
Type=simple
User=jetson
Environment="HOME=/home/jetson"
Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=file:///home/jetson/cyclonedds_eth.xml"
Restart=on-failure
RestartSec=1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/jetson/pingpong/ros2_ws/install/setup.bash && exec /usr/bin/python3 /home/jetson/unitree_rl_lab_lgy/deploy/robots/a1_h1/jetson_camera/relative_camera_time_relay.py --ros-args -p raw_topic:=/pingpong_location_raw -p legacy_topic:=/pingpong_location -p relative_topic:=/pingpong_location_relative -p min_age_s:=0.005 -p max_age_s:=0.120'

[Install]
WantedBy=multi-user.target
